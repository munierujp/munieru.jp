{
  "extends": ["markuplint:recommended-vue"],
  "parser": {
    "\\.vue$": "@markuplint/vue-parser"
  },
  "specs": {
    "\\.vue$": "@markuplint/vue-spec"
  },
  "nodeRules": [
    {
      "selector": "ul[role=\"list\"]",
      "rules": {
        "a11y/wai-aria/implicit-role": false
      }
    }
  ]
}
