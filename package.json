{
  "name": "munieru.jp",
  "version": "2.0.0",
  "description": "ムニエル OFFICIAL SITE",
  "author": "Munieru",
  "private": true,
  "scripts": {
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "generate:ogp": "node scripts/generate-ogp.ts",
    "dev": "nuxt dev",
    "start": "node scripts/preview.ts",
    "prepare": "nuxt prepare",
    "test": "npm run test:unit",
    "typecheck": "nuxt typecheck",
    "lint": "run-s lint:eslint lint:secretlint lint:stylelint lint:markuplint lint:lockfile",
    "lint:fix": "run-s lint:eslint:fix lint:stylelint:fix lint",
    "lint:secretlint": "secretlint \"**/*\"",
    "lint:stylelint": "stylelint \"assets/**/*.css\" --max-warnings=0",
    "lint:stylelint:fix": "npm run lint:stylelint -- --fix",
    "lint:markuplint": "markuplint \"app/**/*.vue\" --max-warnings=0",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:eslint:fix": "eslint . --fix --max-warnings=0",
    "lint:lockfile": "lockfile-lint",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:integration": "node --test test/integration/*.test.ts",
    "lighthouse": "run-s lighthouse:collect lighthouse:upload",
    "lighthouse:collect": "lhci collect",
    "lighthouse:upload": "lhci upload",
    "lighthouse:summary": "node scripts/lighthouse-summary.ts"
  },
  "engines": {
    "node": "26.6.0"
  },
  "dependencies": {
    "@nuxt/image": "2.2.1",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/sitemap": "9.1.0",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "type": "module",
  "devDependencies": {
    "@iconify-json/lucide": "1.2.151",
    "@iconify-json/simple-icons": "1.2.101",
    "@lhci/cli": "0.16.0",
    "@markuplint/ml-config": "5.4.0",
    "@markuplint/vue-parser": "5.4.0",
    "@markuplint/vue-spec": "5.4.0",
    "@nuxt/eslint": "1.17.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@secretlint/types": "13.1.0",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "canvas": "3.2.3",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "lockfile-lint": "5.1.0",
    "markuplint": "5.4.0",
    "neostandard": "0.14.1",
    "npm-run-all2": "9.0.4",
    "secretlint": "13.1.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  }
}
