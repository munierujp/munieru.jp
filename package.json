{
  "name": "munieru.jp",
  "version": "2.0.0",
  "description": "ムニエル OFFICIAL SITE",
  "author": "Munieru",
  "private": true,
  "scripts": {
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "generate:ogp": "node scripts/generate-ogp.ts",
    "dev": "nuxt dev --host 127.0.0.1",
    "start": "node scripts/preview.ts",
    "prepare": "nuxt prepare",
    "test": "node --test",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:secretlint": "secretlint \"**/*\"",
    "lint:stylelint": "stylelint \"assets/**/*.css\" --max-warnings=0",
    "lint:stylelint:fix": "npm run lint:stylelint -- --fix",
    "lint:markuplint": "markuplint \"app/**/*.vue\" --max-warnings=0"
  },
  "engines": {
    "node": "~26.6.0"
  },
  "dependencies": {
    "@nuxt/image": "2.2.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/sitemap": "9.1.0",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "type": "module",
  "devDependencies": {
    "@markuplint/ml-config": "5.4.0",
    "@markuplint/vue-parser": "5.4.0",
    "@markuplint/vue-spec": "5.4.0",
    "@napi-rs/canvas": "1.1.0",
    "@nuxt/eslint": "1.17.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@secretlint/types": "13.1.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "markuplint": "5.4.0",
    "neostandard": "0.14.1",
    "secretlint": "13.1.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  }
}
