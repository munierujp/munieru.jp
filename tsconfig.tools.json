{
  // Nuxt外で実行するスクリプト・テスト・設定を検査する。
  // Node 26の実行環境・TS直接実行の制約・厳格なチェックは共有設定へ委譲する。
  "extends": [
    "@tsconfig/node26/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    ".secretlintrc.js"
  ],
  // nuxt.config.tsはルートtsconfigの参照先で、Nuxt固有の型とともに検査する。
  "exclude": ["nuxt.config.ts"]
}
