{
  // Nuxt外で実行するスクリプト・設定を検査する。
  // Node 26の実行環境・TS直接実行の制約・厳格なチェックは共有設定へ委譲する。
  "extends": [
    "@tsconfig/node26/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true
  },
  // 新規ディレクトリ・ドットファイルも探索し、個別のファイル名を登録しない。
  "include": ["**/*", "**/.*", "**/.*/**/*"],
  // Nuxtが検査するソース領域と、依存関係・生成物・Git管理データを除く。
  "exclude": [
    "**/node_modules",
    ".git",
    ".nuxt",
    ".output",
    ".cache",
    ".data",
    "dist",
    "app",
    "i18n",
    "shared",
    "nuxt.config.ts"
  ]
}
